  el("  jle .Lt_wp_done")
  el("  mov rax, [rsp]")
  el(".Lt_wp_done:")
  el("  add rsp, 16")
  el("  ret")
}

fn rt_emit_pipe() {
  el("__t_pipe:")
  el("  push rbx")
  el("  mov rbx, rdi")
  el("  sub rsp, 16")
  el("  cmp qword ptr [rbx - 8], 2")
  el("  jl .Lt_pipe_fail")
  el("  mov rdi, rsp")
  el("  mov eax, 22")
  el("  syscall")
  el("  test rax, rax")
  el("  js .Lt_pipe_out")
  el("  mov eax, dword ptr [rsp]")
  el("  mov [rbx], rax")
  el("  mov eax, dword ptr [rsp + 4]")
  el("  mov [rbx + 8], rax")
  el("  xor eax, eax")
  el(".Lt_pipe_out:")
  el("  add rsp, 16")
  el("  pop rbx")
  el("  ret")
  el(".Lt_pipe_fail:")
  el("  mov rax, -22")
  el("  add rsp, 16")
  el("  pop rbx")
  el("  ret")
}

fn rt_emit_dup2() {
  el("__t_dup2:")
  el("  mov eax, 33")
  el("  syscall")
  el("  ret")
}

fn rt_emit_kill() {
  el("__t_kill:")
  el("  mov eax, 62")
  el("  syscall")
  el("  ret")
}

fn rt_emit_getppid() {
  el("__t_getppid:")
  el("  mov eax, 110")
  el("  syscall")
  el("  ret")
}
