fn main() {
  print_int(1 + 2 * 3)
  print(" ")
  print_int((1 + 2) * 3)
  print(" ")
  print_int(17 / 5)
  print(" ")
  print_int(17 % 5)
  print(" ")
  print_int(-17 / 5)
  print(" ")
  print_int(-17 % 5)
  print(" ")
  print_int(2 - 5)
  print("\n")
  print_int(3 < 4)
  print_int(3 > 4)
  print_int(4 == 4)
  print_int(4 != 4)
  print_int(3 <= 3)
  print_int(!0)
  print_int(!5)
  print_int(1 && 0)
  print_int(1 || 0)
  print("\n")
}
